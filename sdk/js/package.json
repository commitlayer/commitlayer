{
  "name": "commitlayer",
  "version": "0.1.6",
  "description": "CommitLayer JavaScript SDK: record agent actions, push facts, read verdicts, draft contracts",
  "license": "MIT",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/version.mjs && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "test": "node scripts/version.mjs && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "homepage": "https://commitlayer.ai/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commitlayer/commitlayer.git",
    "directory": "sdk/js"
  },
  "bugs": {
    "url": "https://commitlayer.ai/contact"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "verification",
    "audit",
    "mcp",
    "observability"
  ]
}
