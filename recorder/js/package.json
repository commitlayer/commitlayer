{
  "name": "@commitlayer/mcp-recorder",
  "version": "0.1.1",
  "description": "CommitLayer MCP Recorder: a stdio proxy that records an MCP tool call as a CommitLayer action before forwarding it to the downstream server",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "commitlayer-mcp-recorder": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "homepage": "https://commitlayer.ai/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commitlayer/commitlayer.git",
    "directory": "recorder/js"
  },
  "bugs": {
    "url": "https://commitlayer.ai/contact"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "verification",
    "audit",
    "mcp",
    "observability"
  ]
}
